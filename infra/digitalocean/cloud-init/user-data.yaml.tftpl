#cloud-config
# Rendered by Terraform (templatefile). Runs once on first boot.
# Secrets are deliberately NOT placed here: droplet user-data is readable via
# the metadata service. Backup credentials are added after boot (see README).

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - age
  - rclone
  - fail2ban
  - unattended-upgrades
  - apt-listchanges

users:
  - default
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
%{ if length(admin_authorized_keys) > 0 ~}
    ssh_authorized_keys:
%{ for k in admin_authorized_keys ~}
      - ${k}
%{ endfor ~}
%{ endif ~}

ssh_pwauth: false

write_files:
  - path: /etc/ssh/sshd_config.d/99-daxa-hardening.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      PermitRootLogin ${disable_root_ssh ? "no" : "prohibit-password"}
      MaxAuthTries 4
      LoginGraceTime 30
      X11Forwarding no
      AllowAgentForwarding no

  - path: /etc/fail2ban/jail.d/sshd.local
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      findtime = 10m
      bantime = 1h

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  # Keep the NVIDIA driver/CUDA stack pinned to what the AI/ML image ships;
  # driver upgrades are done deliberately during a maintenance window.
  - path: /etc/apt/apt.conf.d/51daxa-unattended-blacklist
    permissions: "0644"
    content: |
      Unattended-Upgrade::Package-Blacklist {
          "nvidia-";
          "libnvidia-";
          "cuda-";
          "linux-";
      };
      Unattended-Upgrade::Automatic-Reboot "false";

  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "50m", "max-file": "5" },
        "live-restore": true
      }

  - path: /etc/daxa/backup.env.example
    permissions: "0644"
    content: |
      # Copy to /etc/daxa/backup.env (chmod 600) and fill in. See README.
      PG_CONTAINER=daxa-postgres
      PG_SUPERUSER=postgres
      BACKUP_LOCAL_DIR=${data_mount_point}/backups/postgres
      BACKUP_LOCAL_RETENTION_DAYS=3
      # age public key (age1...). The private key stays OFF the server.
      AGE_RECIPIENT=
      # DigitalOcean Spaces (S3-compatible), bucket-scoped key recommended
      SPACES_REGION=${backup_spaces_region}
      SPACES_BUCKET=${backup_bucket_name}
      SPACES_PREFIX=postgres
      SPACES_ACCESS_KEY_ID=
      SPACES_SECRET_ACCESS_KEY=
      # Optional dead-man's-switch URL (e.g. healthchecks.io); pinged on success, /fail on error
      HEALTHCHECK_URL=

  - path: /etc/systemd/system/daxa-pg-backup.service
    permissions: "0644"
    content: |
      [Unit]
      Description=DAXA PostgreSQL encrypted off-server backup
      Wants=network-online.target docker.service
      After=network-online.target docker.service
      ConditionPathExists=/etc/daxa/backup.env

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/daxa-pg-backup
      Nice=10
      IOSchedulingClass=best-effort
      IOSchedulingPriority=7

  - path: /etc/systemd/system/daxa-pg-backup.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Daily DAXA PostgreSQL backup

      [Timer]
      OnCalendar=${backup_schedule}
      RandomizedDelaySec=10m
      Persistent=true

      [Install]
      WantedBy=timers.target

  - path: /usr/local/sbin/daxa-pg-backup
    permissions: "0750"
    content: |
      ${indent(6, backup_script)}

  - path: /usr/local/sbin/daxa-bootstrap
    permissions: "0750"
    content: |
      ${indent(6, bootstrap_script)}

runcmd:
  - [ /usr/local/sbin/daxa-bootstrap, "${admin_username}", "${volume_name}", "${data_mount_point}" ]

final_message: "DAXA bootstrap finished after $UPTIME seconds. Log: /var/log/daxa-bootstrap.log"
