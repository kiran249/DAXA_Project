# Copy to /opt/daxa/deploy/.env on the server (chmod 600). Never commit .env.

# Public hostnames (A records -> reserved IP from `terraform output public_ip`)
APP_DOMAIN=app.daxa.example.com
API_DOMAIN=api.daxa.example.com
AUTH_DOMAIN=auth.daxa.example.com
ACME_EMAIL=ops@example.com

# Persistent volume mount (from Terraform data_mount_point)
DATA_ROOT=/mnt/daxa_data

# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random

# Application database
APP_DB=daxa
APP_DB_USER=daxa_app
APP_DB_PASSWORD=change-me-long-random

# Keycloak
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-long-random
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-long-random
